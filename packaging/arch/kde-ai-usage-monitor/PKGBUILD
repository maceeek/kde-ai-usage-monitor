# Maintainer: kde-ai-usage-monitor contributors
#
# Builds the latest tagged release. paru installs and updates it straight from
# this repository (see "Install with paru" in the README); by hand:
#
#   cd packaging/arch/kde-ai-usage-monitor && makepkg -si
#
# pkgver must match the version in Cargo.toml — `scripts/check-version.py`
# enforces that in CI, and the release workflow tags v<pkgver> once the bump
# lands on main. The source is the git tag rather than a tarball, so there is
# no checksum to refresh by hand on every release.

pkgname=kde-ai-usage-monitor
pkgver=0.2.0
pkgrel=1
pkgdesc="AI coding-assistant usage monitor for KDE Plasma (Claude Code, Codex, GitHub Copilot, Cursor, OpenCode, Antigravity)"
arch=('x86_64' 'aarch64')
url="https://github.com/maceeek/kde-ai-usage-monitor"
license=('MIT')
depends=('gcc-libs' 'sqlite' 'plasma-workspace')
makedepends=('git' 'cargo')
optdepends=('kwallet: read tokens stored in KWallet'
            'libsecret: read tokens stored in the freedesktop Secret Service')
# The `ring` crate ships hand-written C and assembly that its build script
# compiles with the CFLAGS makepkg exports. When makepkg.conf enables LTO
# globally (CachyOS does, and Arch users often do) those objects land in
# libring-core.a as GCC LTO bitcode, which the linker rustc drives cannot
# resolve — the build dies on undefined ring_core_* symbols. Rust does its own
# LTO via the release profile anyway, so drop makepkg's.
options=('!lto')
conflicts=("${pkgname}-git")
source=("${pkgname}::git+${url}.git#tag=v${pkgver}")
sha256sums=('SKIP')

prepare() {
    cd "${srcdir}/${pkgname}"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "${srcdir}/${pkgname}"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release
}

check() {
    cd "${srcdir}/${pkgname}"
    export RUSTUP_TOOLCHAIN=stable
    cargo test --frozen --release
}

package() {
    cd "${srcdir}/${pkgname}"
    install -Dm755 "target/release/${pkgname}" "${pkgdir}/usr/bin/${pkgname}"
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -Dm644 NOTICE "${pkgdir}/usr/share/licenses/${pkgname}/NOTICE"
    install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"

    local appletdir="${pkgdir}/usr/share/plasma/plasmoids/com.github.maceeek.aiusagemonitor"
    install -dm755 "${appletdir}"
    cp -r plasmoid/package/. "${appletdir}/"
    find "${appletdir}" -type d -exec chmod 755 {} +
    find "${appletdir}" -type f -exec chmod 644 {} +
}
