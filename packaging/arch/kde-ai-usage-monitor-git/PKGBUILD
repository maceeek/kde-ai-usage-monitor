# Maintainer: kde-ai-usage-monitor contributors
#
# Builds straight from the main branch — use this one on Arch and CachyOS until
# there is a tagged release you want instead:
#
#   cd packaging/arch/kde-ai-usage-monitor-git && makepkg -si

pkgname=kde-ai-usage-monitor-git
_pkgname=kde-ai-usage-monitor
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc="AI coding-assistant usage monitor for KDE Plasma (Claude Code, Codex, Cursor, OpenCode, Antigravity)"
arch=('x86_64' 'aarch64')
url="https://github.com/maceeek/kde-ai-usage-monitor"
license=('MIT')
depends=('gcc-libs' 'sqlite' 'plasma-workspace')
makedepends=('git' 'cargo')
optdepends=('kwallet: read tokens stored in KWallet'
            'libsecret: read tokens stored in the freedesktop Secret Service')
provides=("${_pkgname}")
conflicts=("${_pkgname}")
source=("git+${url}.git")
sha256sums=('SKIP')

pkgver() {
    cd "${srcdir}/${_pkgname}"
    # Falls back to the crate version when the checkout has no tags yet.
    git describe --long --tags 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' ||
        printf "0.1.0.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
    cd "${srcdir}/${_pkgname}"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "${srcdir}/${_pkgname}"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release
}

check() {
    cd "${srcdir}/${_pkgname}"
    export RUSTUP_TOOLCHAIN=stable
    cargo test --frozen --release
}

package() {
    cd "${srcdir}/${_pkgname}"
    install -Dm755 "target/release/${_pkgname}" "${pkgdir}/usr/bin/${_pkgname}"
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -Dm644 NOTICE "${pkgdir}/usr/share/licenses/${pkgname}/NOTICE"
    install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"

    # The applet id doubles as its install directory, which is how Plasma finds
    # it without a running kpackagetool.
    local appletdir="${pkgdir}/usr/share/plasma/plasmoids/com.github.maceeek.aiusagemonitor"
    install -dm755 "${appletdir}"
    cp -r plasmoid/package/. "${appletdir}/"
    find "${appletdir}" -type d -exec chmod 755 {} +
    find "${appletdir}" -type f -exec chmod 644 {} +
}
